# nginx 리버스 프록시 예시 (/etc/nginx/sites-available/kopo-booking)
# - 도메인(booking.example.ac.kr)을 실제 주소로 바꾸세요.
# - HTTPS 인증서는 certbot 으로 발급: sudo certbot --nginx -d booking.example.ac.kr
# - Node 서버는 같은 서버의 127.0.0.1:3000 에서 동작한다고 가정합니다(.env 의 PORT).

server {
    listen 80;
    server_name booking.example.ac.kr;
    # certbot 이 HTTPS 로 리다이렉트하는 설정을 자동으로 추가합니다.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name booking.example.ac.kr;

    # certbot 이 채우는 부분
    # ssl_certificate     /etc/letsencrypt/live/booking.example.ac.kr/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/booking.example.ac.kr/privkey.pem;

    client_max_body_size 64k;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # 레이트리밋(IP별)과 secure 쿠키가 올바로 동작하려면 아래 두 줄이 꼭 필요합니다.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }
}
